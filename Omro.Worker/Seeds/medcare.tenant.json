{
  "tenantId": "11111111-1111-1111-1111-111111111111",
  "tenantSlug": "medcare-cl",
  "displayName": "MedCare OS",
  "isActive": true,
  "basePromptContext": "Eres el asistente de enriquecimiento operativo para MedCare OS. La decisión, acción permitida y endpoint son determinados exclusivamente por el motor de políticas determinista y el catálogo del tenant. Tu función es redactar un título breve, justificación clara en español y completar únicamente los campos editables permitidos por la acción.",
  "autonomousExecutionEnabled": false,
  "featureFlags": {
    "auto_overbook_enabled": false
  },
  "hitlProposalTtlMinutes": 180,
  "hitlProposalMinLeadMinutes": 60,
  "dedupWindowMinutes": 60,
  "allowedEndpointHosts": [
    "${OMRO_SEED_MEDCARE_BASE_URL:-https://medcare-cqrs-clinical-api.onrender.com}"
  ],
  "auth": {
    "scheme": "Rs256Jwt",
    "issuer": "omro-orchestrator",
    "audience": "medcareos-api",
    "role": "omro_service",
    "signingKeyRef": "default"
  },
  "maxPayloadBytes": 65536,
  "egressTimeoutSeconds": 15,
  "llmConfig": {
    "enrichmentEnabled": true,
    "preferredProvider": "Groq"
  },
  "configVersion": 1,
  "actions": [
    {
      "actionType": "GENERATE_OVERBOOK",
      "description": "Genera un bloque de sobrecupo controlado sobre la cita de origen cuando la política autoriza ejecución autónoma o tras aprobación HITL.",
      "endpointUrl": "${OMRO_SEED_MEDCARE_BASE_URL:-https://medcare-cqrs-clinical-api.onrender.com}/api/appointments/overbook",
      "httpMethod": "POST",
      "requiresApproval": false,
      "allowedPhases": "Both",
      "schemaVersion": 1,
      "llmEditableFields": [ "reason" ],
      "retryPolicy": {
        "maxRetryAttempts": 3,
        "initialDelayMs": 1000,
        "attemptTimeoutSeconds": 15,
        "maxTotalAttempts": 12
      },
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [ "resourceId", "decisionMode" ],
        "properties": {
          "resourceId": { "type": "string", "format": "uuid" },
          "reason": { "type": [ "string", "null" ], "maxLength": 500 },
          "correlationId": { "type": [ "string", "null" ], "format": "uuid" },
          "decisionMode": { "type": "string", "enum": [ "Autonomous", "Approved" ] },
          "targetRisk": { "type": [ "number", "null" ], "minimum": 0, "maximum": 1 },
          "autoApprove": { "type": [ "boolean", "null" ] }
        }
      },
      "defaultPayloadTemplate": {
        "resourceId": "{{resourceId}}",
        "reason": "{{policyReason}}",
        "correlationId": "{{correlationId}}",
        "decisionMode": "Autonomous",
        "targetRisk": "{{riskProbability}}"
      },
      "isActive": true
    },
    {
      "actionType": "PROPOSE_RESOLUTION",
      "description": "Envía una propuesta de resolución HITL a MedCare OS para revisión y aprobación humana antes de ejecutar acciones diferidas.",
      "endpointUrl": "${OMRO_SEED_MEDCARE_BASE_URL:-https://medcare-cqrs-clinical-api.onrender.com}/api/resolutions/propose",
      "httpMethod": "POST",
      "requiresApproval": true,
      "allowedPhases": "Immediate",
      "schemaVersion": 2,
      "llmEditableFields": [],
      "retryPolicy": {
        "maxRetryAttempts": 3,
        "initialDelayMs": 1000,
        "attemptTimeoutSeconds": 15,
        "maxTotalAttempts": 12
      },
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [ "schemaVersion", "resourceId", "riskProbability", "aiPlan" ],
        "properties": {
          "schemaVersion": { "type": "string", "const": "2.0" },
          "resourceId": { "type": "string", "format": "uuid" },
          "riskProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "proposalExpiresAt": { "type": [ "string", "null" ], "format": "date-time" },
          "aiPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "schemaVersion", "title", "reasoning", "confidenceScore", "isShadowModeFallback", "deferredActions" ],
            "properties": {
              "schemaVersion": { "type": "string", "const": "2.0" },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "reasoning": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "confidenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
              "omroTaskId": { "type": [ "string", "null" ], "format": "uuid" },
              "matchedRuleId": { "type": [ "string", "null" ], "maxLength": 200 },
              "policyVersion": { "type": [ "integer", "null" ], "minimum": 1 },
              "proposalExpiresAt": { "type": [ "string", "null" ], "format": "date-time" },
              "isShadowModeFallback": { "type": "boolean" },
              "deferredActions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [ "actionType", "endpoint", "httpMethod", "payload" ],
                  "properties": {
                    "actionType": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "endpoint": { "type": "string", "format": "uri" },
                    "httpMethod": { "type": "string", "enum": [ "POST", "PUT", "PATCH" ] },
                    "payload": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      },
      "defaultPayloadTemplate": {
        "schemaVersion": "2.0",
        "resourceId": "{{resourceId}}",
        "riskProbability": "{{riskProbability}}",
        "proposalExpiresAt": "{{proposalExpiresAt}}",
        "aiPlan": "{{structuredAiPlan}}"
      },
      "isActive": true
    },
    {
      "actionType": "MONITOR_RESOURCE",
      "description": "Crea una tarea de seguimiento operativo manual en recepción para la cita especificada.",
      "endpointUrl": "${OMRO_SEED_MEDCARE_BASE_URL:-https://medcare-cqrs-clinical-api.onrender.com}/api/appointments/monitor",
      "httpMethod": "POST",
      "requiresApproval": false,
      "allowedPhases": "Both",
      "schemaVersion": 1,
      "llmEditableFields": [ "reason" ],
      "retryPolicy": {
        "maxRetryAttempts": 3,
        "initialDelayMs": 1000,
        "attemptTimeoutSeconds": 15,
        "maxTotalAttempts": 12
      },
      "payloadSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [ "resourceId", "requiresAction" ],
        "properties": {
          "resourceId": { "type": "string", "format": "uuid" },
          "requiresAction": { "type": "boolean" },
          "reason": { "type": [ "string", "null" ], "maxLength": 500 },
          "priority": { "type": [ "string", "null" ], "enum": [ "Low", "Medium", "High", "Critical", null ] }
        }
      },
      "defaultPayloadTemplate": {
        "resourceId": "{{resourceId}}",
        "requiresAction": true,
        "reason": "{{policyReason}}",
        "priority": "High"
      },
      "isActive": true
    }
  ],
  "policies": [
    {
      "anomalyType": "ConfirmationDeadlineMissed",
      "policyVersion": 1,
      "isActive": true,
      "dedupWindowMinutes": 60,
      "decisionTable": {
        "schemaVersion": "1.0",
        "hitPolicy": "FIRST_MATCH",
        "rules": [
          {
            "ruleId": "deadline-final-notice-not-delivered",
            "priority": 10,
            "description": "Si el aviso final no fue entregado, nunca sobrecupar; el tenant escala internamente a ReceptionTask.",
            "when": {
              "any": [
                { "field": "attributes.final_notice_status", "op": "not_in", "values": [ "Delivered", "Read" ], "onMissing": false },
                { "field": "attributes.final_notification_delivered", "op": "neq", "value": "true", "onMissing": false },
                {
                  "all": [
                    { "field": "attributes.final_notice_status", "op": "not_exists" },
                    { "field": "attributes.final_notification_delivered", "op": "not_exists" }
                  ]
                }
              ]
            },
            "then": {
              "outcome": "NoAction",
              "escalateReason": "FINAL_NOTICE_NOT_DELIVERED",
              "invokeLlmEnrichment": false,
              "actions": []
            }
          },
          {
            "ruleId": "deadline-low-risk-no-action",
            "priority": 20,
            "description": "Riesgo bajo [0.00, 0.50): sin intervención.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_half_open",
                  "minInclusive": 0.00,
                  "maxExclusive": 0.50
                }
              ]
            },
            "then": {
              "outcome": "NoAction",
              "invokeLlmEnrichment": false,
              "actions": []
            }
          },
          {
            "ruleId": "deadline-critical-autonomous-with-shadow-gate",
            "priority": 30,
            "description": "Riesgo crítico [0.85, 1.00], aviso Delivered, sin exclusiones clínicas ni edad >= 70.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_closed",
                  "minInclusive": 0.85,
                  "maxInclusive": 1.00
                },
                {
                  "any": [
                    { "field": "attributes.final_notice_status", "op": "in", "values": [ "Delivered", "Read" ] },
                    { "field": "attributes.final_notification_delivered", "op": "eq", "value": "true" }
                  ]
                },
                { "field": "attributes.clinical_exclusion", "op": "neq", "value": "true", "onMissing": true },
                { "field": "attributes.clinical_flags", "op": "is_empty", "onMissing": true },
                { "field": "attributes.edad", "op": "lt", "value": 70, "onMissing": true }
              ]
            },
            "then": {
              "outcome": "ExecuteActions",
              "expectsExternalApproval": false,
              "invokeLlmEnrichment": true,
              "actions": [
                {
                  "actionType": "GENERATE_OVERBOOK",
                  "payloadOverrides": { "decisionMode": "Autonomous" }
                }
              ],
              "autonomyGate": {
                "requiresTenantAutonomousExecution": true,
                "requiredEventAttributeNotFalse": "auto_overbook_enabled",
                "suppressionReason": "AUTONOMOUS_EXECUTION_DISABLED",
                "recordShadowDecision": true,
                "fallbackOutcome": "ProposeForApproval",
                "fallbackExpectsExternalApproval": true,
                "fallbackActions": [
                  {
                    "actionType": "PROPOSE_RESOLUTION",
                    "deferredActions": [
                      {
                        "actionType": "GENERATE_OVERBOOK",
                        "payloadOverrides": { "decisionMode": "Approved" }
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "ruleId": "deadline-moderate-or-excluded-hitl",
            "priority": 40,
            "description": "Riesgo moderado [0.50, 0.85) o riesgo crítico con exclusión clínica / edad >= 70 -> propuesta HITL.",
            "when": {
              "any": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_half_open",
                  "minInclusive": 0.50,
                  "maxExclusive": 0.85
                },
                {
                  "all": [
                    {
                      "field": "attributes.effective_score",
                      "fallbackField": "riskProbability",
                      "op": "gte",
                      "value": 0.85
                    },
                    {
                      "any": [
                        { "field": "attributes.clinical_exclusion", "op": "eq", "value": "true", "onMissing": false },
                        { "field": "attributes.clinical_flags", "op": "not_empty", "onMissing": false },
                        { "field": "attributes.edad", "op": "gte", "value": 70, "onMissing": false }
                      ]
                    }
                  ]
                }
              ]
            },
            "then": {
              "outcome": "ProposeForApproval",
              "expectsExternalApproval": true,
              "invokeLlmEnrichment": true,
              "actions": [
                {
                  "actionType": "PROPOSE_RESOLUTION",
                  "deferredActions": [
                    {
                      "actionType": "GENERATE_OVERBOOK",
                      "payloadOverrides": { "decisionMode": "Approved" }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "defaultDecision": {
          "outcome": "EscalateToHumanReview",
          "reason": "NO_MATCHING_POLICY_RULE",
          "invokeLlmEnrichment": false,
          "actions": []
        }
      }
    },
    {
      "anomalyType": "RiskEscalated",
      "policyVersion": 1,
      "isActive": true,
      "dedupWindowMinutes": 60,
      "decisionTable": {
        "schemaVersion": "1.0",
        "hitPolicy": "FIRST_MATCH",
        "rules": [
          {
            "ruleId": "escalated-low-risk-no-action",
            "priority": 10,
            "description": "Riesgo bajo [0.00, 0.50): sin acción.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_half_open",
                  "minInclusive": 0.00,
                  "maxExclusive": 0.50
                }
              ]
            },
            "then": {
              "outcome": "NoAction",
              "invokeLlmEnrichment": false,
              "actions": []
            }
          },
          {
            "ruleId": "escalated-moderate-or-high-hitl",
            "priority": 20,
            "description": "Riesgo moderado o alto [0.50, 1.00]: propuesta HITL previa al deadline.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_closed",
                  "minInclusive": 0.50,
                  "maxInclusive": 1.00
                }
              ]
            },
            "then": {
              "outcome": "ProposeForApproval",
              "expectsExternalApproval": true,
              "invokeLlmEnrichment": true,
              "actions": [
                {
                  "actionType": "PROPOSE_RESOLUTION",
                  "deferredActions": [
                    {
                      "actionType": "GENERATE_OVERBOOK",
                      "payloadOverrides": { "decisionMode": "Approved" }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "defaultDecision": {
          "outcome": "EscalateToHumanReview",
          "reason": "NO_MATCHING_POLICY_RULE",
          "invokeLlmEnrichment": false,
          "actions": []
        }
      }
    },
    {
      "anomalyType": "AppointmentNoShowRisk",
      "policyVersion": 1,
      "isActive": true,
      "dedupWindowMinutes": 60,
      "decisionTable": {
        "schemaVersion": "1.0",
        "hitPolicy": "FIRST_MATCH",
        "rules": [
          {
            "ruleId": "legacy-low-risk-no-action",
            "priority": 10,
            "description": "Riesgo bajo [0.00, 0.50): sin acción.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_half_open",
                  "minInclusive": 0.00,
                  "maxExclusive": 0.50
                }
              ]
            },
            "then": {
              "outcome": "NoAction",
              "invokeLlmEnrichment": false,
              "actions": []
            }
          },
          {
            "ruleId": "legacy-moderate-or-high-hitl",
            "priority": 20,
            "description": "Compatibilidad legacy [0.50, 1.00]: propuesta HITL.",
            "when": {
              "all": [
                {
                  "field": "attributes.effective_score",
                  "fallbackField": "riskProbability",
                  "op": "range_closed",
                  "minInclusive": 0.50,
                  "maxInclusive": 1.00
                }
              ]
            },
            "then": {
              "outcome": "ProposeForApproval",
              "expectsExternalApproval": true,
              "invokeLlmEnrichment": true,
              "actions": [
                {
                  "actionType": "PROPOSE_RESOLUTION",
                  "deferredActions": [
                    {
                      "actionType": "GENERATE_OVERBOOK",
                      "payloadOverrides": { "decisionMode": "Approved" }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "defaultDecision": {
          "outcome": "EscalateToHumanReview",
          "reason": "NO_MATCHING_POLICY_RULE",
          "invokeLlmEnrichment": false,
          "actions": []
        }
      }
    }
  ]
}
